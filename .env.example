# 复制这个文件为 .env，然后填入你的 Key（.env 不要提交到 git）

# 用哪家：deepseek / zhipu / openai
PROVIDER=deepseek

# DeepSeek（https://platform.deepseek.com 注册后创建 Key）
DEEPSEEK_API_KEY=

# 智谱 GLM（https://open.bigmodel.cn ，glm-4-flash 有免费额度，适合练手）
ZHIPU_API_KEY=

# OpenAI（如果你有）
OPENAI_API_KEY=

# 想用别的模型就填这里，留空则用 PROVIDER 的默认模型
MODEL=
